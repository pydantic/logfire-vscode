{
    "name": "logfire",
    "displayName": "Pydantic Logfire",
    "description": "A Visual Studio Code extension for Pydantic Logfire: Live View CodeLens for your logging calls, plus the Logfire AI Gateway as a Chat model provider (CIMD OAuth, no API key).",
    "icon": "assets/icon.png",
    "version": "2025.3.0",
    "preview": true,
    "serverInfo": {
        "name": "Pydantic Logfire",
        "module": "logfire"
    },
    "publisher": "Pydantic",
    "license": "MIT",
    "packageManager": "pnpm@10.33.0",
    "homepage": "https://github.com/pydantic/logfire-vscode",
    "repository": {
        "type": "git",
        "url": "https://github.com/pydantic/logfire-vscode.git"
    },
    "bugs": {
        "url": "https://github.com/pydantic/logfire-vscode/issues"
    },
    "galleryBanner": {
        "color": "#1d0214",
        "theme": "dark"
    },
    "keywords": [
        "python",
        "logfire",
        "pydantic",
        "llm",
        "openai",
        "anthropic",
        "ai-gateway",
        "byok",
        "copilot",
        "otel",
        "opentelemetry",
        "observability",
        "oauth"
    ],
    "engines": {
        "vscode": "^1.104.0"
    },
    "categories": [
        "Programming Languages",
        "AI",
        "Chat",
        "Machine Learning"
    ],
    "extensionDependencies": [
        "ms-python.python"
    ],
    "capabilities": {
        "virtualWorkspaces": {
            "supported": false,
            "description": "Virtual Workspaces are not supported with Pydantic Logfire."
        }
    },
    "activationEvents": [
        "onLanguage:python",
        "workspaceContains:*.py",
        "onLanguageModelChatProvider:logfire-gateway"
    ],
    "main": "./dist/extension.js",
    "scripts": {
        "vscode:prepublish": "pnpm run package",
        "compile": "webpack",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool source-map --config ./webpack.config.js",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
        "lint": "eslint src --ext ts",
        "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts' 'build/**/*.yml' '.github/**/*.yml'",
        "format-check": "prettier --check 'src/**/*.ts' 'test/**/*.ts' 'build/**/*.yml' '.github/**/*.yml'",
        "test": "node ./out/test/runTest.js",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "gen:icon": "node scripts/gen-icon.mjs"
    },
    "contributes": {
        "configuration": {
            "properties": {
                "logfire.environment": {
                    "default": null,
                    "markdownDescription": "The [environment](https://logfire.pydantic.dev/docs/how-to-guides/environments/) to use when querying spans/logs. If set to `null` (the default), *all envs* will be queried. If set to an empty string (`\"\"`), only the spans *without* an env will be queried.",
                    "scope": "resource",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "logfire.interpreter": {
                    "default": [],
                    "description": "When set to a path to python executable, extension will use that to launch the server and any subprocess.",
                    "scope": "resource",
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "logfire.showNotifications": {
                    "default": "off",
                    "description": "Controls when notifications are shown by this extension.",
                    "enum": [
                        "off",
                        "onError",
                        "onWarning",
                        "always"
                    ],
                    "enumDescriptions": [
                        "All notifications are turned off, any errors or warning are still available in the logs.",
                        "Notifications are shown only in the case of an error.",
                        "Notifications are shown for errors and warnings.",
                        "Notifications are show for anything that the server chooses to show."
                    ],
                    "scope": "machine",
                    "type": "string"
                },
                "logfireGateway.regions": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "us",
                            "eu"
                        ]
                    },
                    "uniqueItems": true,
                    "default": [
                        "us",
                        "eu"
                    ],
                    "markdownDescription": "Hosted Logfire deployments to make available. Sign in to any subset — models from every signed-in instance appear together in the picker."
                },
                "logfireGateway.instances": {
                    "type": "array",
                    "default": [],
                    "markdownDescription": "Self-hosted Logfire instances, in addition to the hosted regions. Each needs an `alias` (shown in the picker) and a base `url` that serves both OAuth and the gateway, or split `backendUrl`/`gatewayUrl`.",
                    "items": {
                        "type": "object",
                        "required": [
                            "alias"
                        ],
                        "properties": {
                            "alias": {
                                "type": "string",
                                "description": "Display name, e.g. \"Acme prod\"."
                            },
                            "url": {
                                "type": "string",
                                "description": "Base URL serving OAuth and gateway, e.g. https://logfire.example.com."
                            },
                            "backendUrl": {
                                "type": "string",
                                "description": "OAuth backend URL (overrides 'url' for split deployments)."
                            },
                            "gatewayUrl": {
                                "type": "string",
                                "description": "Gateway URL (overrides 'url' for split deployments)."
                            },
                            "clientId": {
                                "type": "string",
                                "description": "CIMD client_id URL to authenticate as. Optional — defaults to https://logfire.pydantic.dev/clients/logfire-gateway.json, which works for self-hosted/localhost backends that can't serve their own CIMD document."
                            }
                        }
                    }
                },
                "logfireGateway.requestTimeoutMs": {
                    "type": "number",
                    "default": 180000,
                    "minimum": 5000,
                    "maximum": 600000,
                    "description": "Upstream request timeout in milliseconds."
                },
                "logfireGateway.modelRefreshIntervalMinutes": {
                    "type": "number",
                    "default": 5,
                    "minimum": 0,
                    "maximum": 1440,
                    "description": "How often to refresh the model list, in minutes. Set to 0 to disable automatic refresh (use the \"Refresh Model List\" command instead)."
                },
                "logfireGateway.modelOverrides": {
                    "type": "object",
                    "default": {},
                    "description": "Per-model metadata overrides keyed by bare model id or namespaced 'instance::route::model' id, e.g. { \"gpt-4o\": { \"maxInputTokens\": 128000, \"toolCalling\": true, \"imageInput\": true } }.",
                    "additionalProperties": {
                        "type": "object",
                        "properties": {
                            "maxInputTokens": {
                                "type": "number"
                            },
                            "maxOutputTokens": {
                                "type": "number"
                            },
                            "toolCalling": {
                                "type": "boolean"
                            },
                            "imageInput": {
                                "type": "boolean"
                            },
                            "family": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "languageModelChatProviders": [
            {
                "vendor": "logfire-gateway",
                "displayName": "Logfire AI Gateway",
                "managementCommand": "logfireGateway.manage"
            }
        ],
        "commands": [
            {
                "title": "Restart Server",
                "category": "Pydantic Logfire",
                "command": "logfire.restart"
            },
            {
                "command": "logfireGateway.signIn",
                "title": "Logfire AI Gateway: Sign In",
                "category": "Logfire"
            },
            {
                "command": "logfireGateway.signOut",
                "title": "Logfire AI Gateway: Sign Out",
                "category": "Logfire"
            },
            {
                "command": "logfireGateway.manage",
                "title": "Logfire AI Gateway: Manage",
                "category": "Logfire"
            },
            {
                "command": "logfireGateway.refreshModels",
                "title": "Logfire AI Gateway: Refresh Model List",
                "category": "Logfire"
            }
        ]
    },
    "prettier": {
        "printWidth": 120,
        "tabWidth": 2,
        "singleQuote": true,
        "trailingComma": "all"
    },
    "dependencies": {
        "@vscode/python-extension": "^1.0.5",
        "fs-extra": "^11.2.0",
        "vscode-languageclient": "^8.1.0"
    },
    "devDependencies": {
        "@resvg/resvg-js": "^2.6.2",
        "@types/fs-extra": "^11.0.4",
        "@types/glob": "^8.1.0",
        "@types/node": "20.x",
        "@types/vscode": "^1.104.0",
        "@typescript-eslint/eslint-plugin": "^6.17.0",
        "@typescript-eslint/parser": "^6.17.0",
        "@vscode/test-electron": "^2.3.8",
        "@vscode/vsce": "^2.22.0",
        "eslint": "^8.56.0",
        "glob": "^10.3.10",
        "ovsx": "^0.10.4",
        "prettier": "^3.1.1",
        "ts-loader": "^9.5.1",
        "typescript": "^5.3.3",
        "vitest": "^1.6.0",
        "webpack": "^5.89.0",
        "webpack-cli": "^5.1.4"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@resvg/resvg-js",
            "@vscode/vsce-sign",
            "esbuild",
            "keytar"
        ]
    }
}
